function launchEval() {
    const hc = navigator.hardwareConcurrency || 8;
    let threads = Math.min(runState.threads, hc);
    if (threads < 1) threads = 1;
    runState.running = true; runState.stoppedCount = 0;
    runState.activeWorkers = []; runState.modelsSentTo = new WeakSet();
    runState.inFlight = new Map(); runState.runStartTime = performance.now();
    keepAwake();
    document.querySelectorAll('.bg-layer').forEach(el => el.classList.add('paused'));
    const btn = document.getElementById('runBtn');
    const stopBtn = document.getElementById('stopBtn');
    const prog = document.getElementById('prog');
    btn.disabled = true; stopBtn.style.display = "inline-block";
    prog.innerText = "运行中 (" + threads + " 线程, 块 " + runState.BLOCK + ")...";

    function totalElapsed() { return (runState.accumulatedTime || 0) + (performance.now() - runState.runStartTime); }

    function updateProgress() {
        let now = performance.now();
        if (now - runState.lastRenderTime > 100) {
            runState.lastRenderTime = now;
            if (now - runState.speedSampleTime > 500) {
                let dt = (now - runState.speedSampleTime) / 1000;
                if (dt > 0) runState.instantSpeed = (runState.totalProcessed - runState.speedSampleCount) / dt;
                runState.speedSampleTime = now; runState.speedSampleCount = runState.totalProcessed;
            }
            let shown = Math.min(runState.totalProcessed, runState.totalCount);
            let p = Math.min(100, (shown / runState.totalCount) * 100).toFixed(1);
            let elapsed = totalElapsed() / 1000;
            let avgSpeed = elapsed > 0 ? shown / elapsed : 0;
            let eta = runState.instantSpeed > 0.5 ? (runState.totalCount - shown) / runState.instantSpeed : 0;
            prog.innerText = "进度: " + p + "% (" + shown + " / " + runState.totalCount + ")"
                + " | QP:" + runState.qpList.length + " QD:" + runState.qdList.length
                + " SPP:" + runState.sppList.length + " SCQD:" + runState.scqdList.length
                + " | 已用 " + elapsed.toFixed(1) + "s"
                + " | 实时 " + runState.instantSpeed.toFixed(0) + "/s"
                + " | 平均 " + avgSpeed.toFixed(0) + "/s"
                + " | 剩余 " + eta.toFixed(1) + "s";
        }
    }

    function finish() {
        runState.qpList.sort((a, b) => b.v - a.v);
        runState.qdList.sort((a, b) => b.v - a.v);
        runState.sppList.sort((a, b) => b.v - a.v);
        runState.scqdList.sort((a, b) => b.v - a.v);
        document.getElementById('outQP').value = runState.qpList.map(x => x.s).join('\n');
        document.getElementById('outQD').value = runState.qdList.map(x => x.s).join('\n');
        document.getElementById('outSPP').value = runState.sppList.map(x => x.s).join('\n');
        document.getElementById('outSCQD').value = runState.scqdList.map(x => x.s).join('\n');
        let totalTime = totalElapsed() / 1000;
        let shown = Math.min(runState.totalProcessed, runState.totalCount);
        let avgSpeed = totalTime > 0 ? shown / totalTime : 0;
        btn.disabled = false; stopBtn.style.display = "none";
        document.querySelectorAll('.bg-layer').forEach(el => el.classList.remove('paused'));
        prog.innerText = "✅ 完成 | 处理 " + shown + " / " + runState.totalCount + " 号"
            + " | QP:" + runState.qpList.length + " QD:" + runState.qdList.length
            + " SPP:" + runState.sppList.length + " SCQD:" + runState.scqdList.length
            + " | 总用时 " + totalTime.toFixed(2) + "s"
            + " | 平均 " + avgSpeed.toFixed(0) + "/s";
        runState.paused = false; runState.running = false;
        runState.inFlight.clear(); btn.innerText = "开始筛选";
    }

    function dispatchNext(worker) {
        if (runState.nextStart > runState.end) { worker.postMessage({ type: 'stop' }); return; }
        const ws = runState.nextStart;
        const we = Math.min(ws + runState.BLOCK - 1, runState.end);
        runState.nextStart = we + 1;
        runState.inFlight.set(worker, ws);
        const models = runState.modelsSentTo.has(worker) ? null : modelData;
        runState.modelsSentTo.add(worker);
        worker.postMessage({
            type: 'start', start: ws, end: we,
            prefix: runState.prefix, team: runState.team, th_e8: runState.th_e8,
            th_sqp: runState.th_sqp !== null ? runState.th_sqp : -9999999,
            th_sqd: runState.th_sqd !== null ? runState.th_sqd : -9999999,
            th_spp: runState.th_spp !== null ? runState.th_spp : -9999999,
            th_scqd: runState.th_scqd !== null ? runState.th_scqd : -9999999,
            en_sqp: runState.th_sqp !== null ? 1 : 0,
            en_sqd: runState.th_sqd !== null ? 1 : 0,
            en_spp: runState.th_spp !== null ? 1 : 0,
            en_scqd: runState.th_scqd !== null ? 1 : 0,
            models: models
        });
    }

    for (let t = 0; t < threads; t++) {
        const worker = new Worker(workerUrl);
        runState.activeWorkers.push(worker);
        worker.onerror = function(e) {
            console.error("Worker 崩溃:", e.message);
            runState.stoppedCount++; runState.inFlight.delete(worker);
            try { worker.terminate(); } catch(_) {}
            let idx = runState.activeWorkers.indexOf(worker);
            if (idx >= 0) runState.activeWorkers.splice(idx, 1);
            if (runState.stoppedCount === threads && runState.running) finish();
        };
        worker.onmessage = function(e) {
            const d = e.data;
            if (d.type === 'progress') { runState.totalProcessed += d.count; updateProgress(); }
            else if (d.type === 'done') {
                runState.totalProcessed += d.count;
                runState.inFlight.delete(worker);
                for (let r of d.results) {
                    let s_name = runState.prefix + " " + r.n + "@" + runState.team;
                    if (r.pq) runState.qpList.push({ v: r.qp, s: s_name + " | 八围:" + r.e8.toFixed(2) + " | SQP:" + r.qp });
                    if (r.pd) runState.qdList.push({ v: r.qd, s: s_name + " | 八围:" + r.e8.toFixed(2) + " | SQD:" + r.qd });
                    if (r.ps) runState.sppList.push({ v: r.pp, s: s_name + " | 八围:" + r.e8.toFixed(2) + " | SPP:" + r.pp });
                    if (r.pc) runState.scqdList.push({ v: r.cqd, s: s_name + " | 八围:" + r.e8.toFixed(2) + " | SCQD:" + r.cqd });
                }
                updateProgress(); dispatchNext(worker);
            } else if (d.type === 'stopped') {
                runState.stoppedCount++; runState.inFlight.delete(worker);
                try { worker.terminate(); } catch(_) {}
                let idx = runState.activeWorkers.indexOf(worker);
                if (idx >= 0) runState.activeWorkers.splice(idx, 1);
                if (runState.stoppedCount === threads && runState.running) finish();
            }
        };
        dispatchNext(worker);
    }
}

