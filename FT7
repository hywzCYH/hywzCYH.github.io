function stopEval() {
    if (!runState || !runState.running) return;
    runState.paused = true; runState.running = false;
    runState.accumulatedTime = (runState.accumulatedTime || 0) + (performance.now() - runState.runStartTime);
    let minInflight = runState.nextStart;
    for (let ws of runState.inFlight.values()) if (ws < minInflight) minInflight = ws;
    runState.nextStart = minInflight;
    runState.inFlight.clear();
    for (let w of runState.activeWorkers) { try { w.terminate(); } catch(e) {} }
    runState.activeWorkers = [];
    document.getElementById('runBtn').disabled = false;
    document.getElementById('runBtn').innerText = "▶ 继续 (从 " + runState.nextStart + ")";
    document.getElementById('stopBtn').style.display = "none";
    document.getElementById('prog').innerText = "⏸ 已暂停 | 已处理至 " + runState.nextStart + " / " + runState.end
        + " | QP:" + runState.qpList.length + " QD:" + runState.qdList.length
        + " SPP:" + runState.sppList.length + " SCQD:" + runState.scqdList.length;
}

