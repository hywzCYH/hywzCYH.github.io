<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Namerena 极速工具</title>
<style>
    :root {
        --bg: #ffffff; --bg-card: #ffffff; --bg-input: #ffffff;
        --text: #111111; --text-dim: #6b7280;
        --blue: #3b82f6; --blue-hover: #2563eb; --light-blue: #eff6ff;
        --border: #e5e7eb; --border-light: #f3f4f6;
        --shadow: 0 1px 3px rgba(0,0,0,0.05);
    }
    body.dark {
        --bg: #0a0a0a; --bg-card: #171717; --bg-input: #0a0a0a;
        --text: #f3f3f3; --text-dim: #9ca3af;
        --blue: #60a5fa; --blue-hover: #93c5fd; --light-blue: #1e3a8a;
        --border: #262626; --border-light: #1f1f1f;
        --shadow: 0 1px 3px rgba(0,0,0,0.3);
    }
    * { box-sizing: border-box; }
    html { height: 100%; scroll-behavior: smooth; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
        background: transparent; color: var(--text); margin: 0; padding: 0;
        min-height: 100%; transition: color 0.25s; -webkit-font-smoothing: antialiased;
    }
    #bg-base { position: fixed; inset: 0; background: var(--bg); z-index: -3; transition: background 0.3s; }
    .bg-layer { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; opacity: 0; transition: opacity 0.5s; }
    body[data-bg="fluid"] .bg-layer.fluid { opacity: 1; }
    body[data-bg="gold"] .bg-layer.gold { opacity: 1; }
    .bg-layer.paused .blob { animation-play-state: paused; }
    .blob { position: absolute; border-radius: 50%; will-change: transform; }
    .fluid .b1 { width: 75vmax; height: 75vmax; top: -25vmax; left: -25vmax; background: radial-gradient(circle, rgba(59,130,246,0.38) 0%, rgba(59,130,246,0) 65%); animation: drift1 26s ease-in-out infinite alternate; }
    .fluid .b2 { width: 65vmax; height: 65vmax; bottom: -22vmax; right: -18vmax; background: radial-gradient(circle, rgba(147,51,234,0.28) 0%, rgba(147,51,234,0) 65%); animation: drift2 33s ease-in-out infinite alternate; }
    .fluid .b3 { width: 55vmax; height: 55vmax; top: 35%; left: 42%; background: radial-gradient(circle, rgba(6,182,212,0.24) 0%, rgba(6,182,212,0) 65%); animation: drift3 39s ease-in-out infinite alternate; }
    body.dark .fluid .b1 { background: radial-gradient(circle, rgba(96,165,250,0.30) 0%, rgba(96,165,250,0) 65%); }
    body.dark .fluid .b2 { background: radial-gradient(circle, rgba(168,85,247,0.24) 0%, rgba(168,85,247,0) 65%); }
    body.dark .fluid .b3 { background: radial-gradient(circle, rgba(34,211,238,0.18) 0%, rgba(34,211,238,0) 65%); }
    .gold .b1 { width: 80vmax; height: 80vmax; top: -28vmax; left: -22vmax; background: radial-gradient(circle, rgba(249,115,22,0.42) 0%, rgba(249,115,22,0) 65%); animation: drift1 30s ease-in-out infinite alternate; }
    .gold .b2 { width: 70vmax; height: 70vmax; bottom: -26vmax; right: -20vmax; background: radial-gradient(circle, rgba(245,158,11,0.36) 0%, rgba(245,158,11,0) 65%); animation: drift2 37s ease-in-out infinite alternate; }
    .gold .b3 { width: 60vmax; height: 60vmax; top: 30%; left: 48%; background: radial-gradient(circle, rgba(217,70,239,0.28) 0%, rgba(217,70,239,0) 65%); animation: drift3 42s ease-in-out infinite alternate; }
    body.dark .gold .b1 { background: radial-gradient(circle, rgba(251,146,60,0.30) 0%, rgba(251,146,60,0) 65%); }
    body.dark .gold .b2 { background: radial-gradient(circle, rgba(250,204,21,0.24) 0%, rgba(250,204,21,0) 65%); }
    body.dark .gold .b3 { background: radial-gradient(circle, rgba(232,121,249,0.20) 0%, rgba(232,121,249,0) 65%); }
    @keyframes drift1 { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(28vmax, 18vmax) scale(1.22); } }
    @keyframes drift2 { 0% { transform: translate(0,0) scale(1.1); } 100% { transform: translate(-24vmax, -20vmax) scale(0.88); } }
    @keyframes drift3 { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(-18vmax, 26vmax) scale(1.18); } }

    .navbar { position: fixed; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 10px 20px; border-bottom: 1px solid var(--border); background: var(--bg); z-index: 1000; box-shadow: var(--shadow); }
    .nav-tabs { display: flex; gap: 6px; overflow-x: auto; flex: 1; }
    .nav-tab { padding: 8px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; background: transparent; border: 1px solid transparent; color: var(--text-dim); transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
    .nav-tab:hover { color: var(--text); }
    .nav-tab.active { background: var(--light-blue); color: var(--blue); border-color: var(--blue); }
    .nav-actions { display: flex; gap: 8px; flex-shrink: 0; margin-left: 10px; }
    .icon-btn { padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; background: var(--bg-card); border: 1px solid var(--border); color: var(--text); transition: all 0.15s; }
    .icon-btn:hover { background: var(--light-blue); border-color: var(--blue); color: var(--blue); }

    .container { max-width: 1000px; margin: 0 auto; padding: 72px 20px 20px; }
    .page { display: none; }
    .page.active { display: block; animation: fadeIn 0.25s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: var(--shadow); }
    .card-title { font-size: 13px; font-weight: 700; color: var(--text-dim); margin: 0 0 14px 0; letter-spacing: 0.5px; }
    .row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
    .row:last-child { margin-bottom: 0; }
    .item { flex: 1; min-width: 110px; }
    .item label { display: block; font-size: 12px; font-weight: 600; color: var(--text-dim); margin-bottom: 6px; }
    input, select, textarea { width: 100%; padding: 9px 12px; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-input); color: var(--text); font-size: 14px; font-family: inherit; transition: all 0.15s; }
    input:focus, textarea:focus, select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    textarea { resize: vertical; height: 160px; font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 12px; line-height: 1.5; }

    .actions { display: flex; gap: 10px; margin: 16px 0; flex-wrap: wrap; }
    .btn-primary { padding: 11px 24px; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; flex: 1; min-width: 180px; box-shadow: 0 2px 8px rgba(59,130,246,0.3); transition: all 0.15s; }
    .btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(59,130,246,0.4); }
    .btn-primary:active:not(:disabled) { transform: translateY(0); }
    .btn-primary:disabled { background: var(--border); color: var(--text-dim); cursor: not-allowed; box-shadow: none; }
    .btn-danger { padding: 11px 20px; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; background: linear-gradient(135deg, #ef4444, #dc2626); color: white; box-shadow: 0 2px 8px rgba(239,68,68,0.3); }
    .btn-small { padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; background: var(--bg-card); color: var(--text-dim); transition: all 0.15s; }
    .btn-small:hover { background: var(--light-blue); border-color: var(--blue); color: var(--blue); }

    .prog { font-size: 12px; color: var(--text-dim); margin: 12px 0; padding: 12px; background: var(--border-light); border-radius: 8px; font-family: "SF Mono", Monaco, Consolas, monospace; line-height: 1.6; word-break: break-all; }

    .results-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 720px) { .results-grid { grid-template-columns: 1fr; } }
    .result-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); position: relative; }
    .result-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: 12px 12px 0 0; }
    .result-card.qp::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .result-card.qd::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
    .result-card.pp::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .result-card.cqd::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .result-card.e8h::before { background: linear-gradient(90deg, #ec4899, #f472b6); }
    .result-card.gl::before { background: linear-gradient(90deg, #06b6d4, #22d3ee); }
    .result-card.ar::before { background: linear-gradient(90deg, #ef4444, #f87171); }

    .result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .result-title { font-size: 13px; font-weight: 700; color: var(--text); }
    .result-title .badge { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 10px; margin-left: 6px; font-weight: 600; }
    .qp .badge { background: #dbeafe; color: #1d4ed8; }
    .qd .badge { background: #ede9fe; color: #6d28d9; }
    .pp .badge { background: #d1fae5; color: #047857; }
    .cqd .badge { background: #fef3c7; color: #b45309; }
    .e8h .badge { background: #fce7f3; color: #9d174d; }
    .gl .badge { background: #cffafe; color: #155e75; }
    .ar .badge { background: #fee2e2; color: #991b1b; }
    body.dark .qp .badge { background: #1e3a8a; color: #93c5fd; }
    body.dark .qd .badge { background: #4c1d95; color: #c4b5fd; }
    body.dark .pp .badge { background: #064e3b; color: #6ee7b7; }
    body.dark .cqd .badge { background: #78350f; color: #fcd34d; }
    body.dark .e8h .badge { background: #831843; color: #fbcfe8; }
    body.dark .gl .badge { background: #164e63; color: #a5f3fc; }
    body.dark .ar .badge { background: #7f1d1d; color: #fecaca; }

    .result-card textarea { height: 200px; }

    /* ============ 教程页样式 ============ */
    .tut-hero { text-align: center; padding: 10px 0 24px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
    .tut-hero h1 { font-size: 26px; font-weight: 800; margin: 0 0 6px 0; letter-spacing: -0.02em; color: var(--text); }
    .tut-hero h1 span { color: var(--blue); }
    .tut-hero .sub { color: var(--text-dim); font-size: 13px; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; }
    .tut-hero .sub .dot::before { content: "·"; margin-right: 6px; }
    .tut-toc { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
    .tut-toc a { font-size: 13px; font-weight: 600; padding: 6px 14px; border-radius: 20px; background: var(--bg-card); border: 1px solid var(--border); color: var(--text-dim); transition: all 0.15s; text-decoration: none; }
    .tut-toc a:hover { border-color: var(--blue); color: var(--blue); background: var(--light-blue); }
    .tut-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 24px 26px; margin-bottom: 18px; box-shadow: var(--shadow); }
    .tut-card h2 { font-size: 19px; font-weight: 800; margin: 0 0 16px 0; display: flex; align-items: center; gap: 10px; color: var(--text); }
    .tut-card h2 .num { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 8px; background: var(--light-blue); color: var(--blue); font-size: 14px; font-weight: 800; flex-shrink: 0; }
    .tut-card h3 { font-size: 15.5px; font-weight: 700; margin: 20px 0 10px 0; color: var(--text); }
    .tut-card h3:first-of-type { margin-top: 6px; }
    .tut-card p { margin: 0 0 12px 0; font-size: 14.5px; line-height: 1.75; color: var(--text); }
    .tut-card p:last-child { margin-bottom: 0; }
    .tut-card ul, .tut-card ol { margin: 10px 0 14px 22px; font-size: 14.5px; color: var(--text); }
    .tut-card li { margin-bottom: 6px; }
    .tut-card a { color: var(--blue); text-decoration: none; border-bottom: 1px solid transparent; }
    .tut-card a:hover { border-bottom-color: var(--blue); }
    .tut-card code { background: var(--border-light); padding: 2px 7px; border-radius: 5px; font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 13px; color: var(--text); }
    .tut-card strong { font-weight: 700; }
    .tut-callout { padding: 14px 18px; border-radius: 10px; font-size: 14px; margin: 16px 0; border-left: 3px solid var(--blue); background: var(--light-blue); color: var(--text); }
    .tut-callout.warn { border-left-color: #fcd34d; background: #fffbeb; color: #78350f; }
    body.dark .tut-callout.warn { background: #2a1f0a; border-left-color: #a16207; color: #fcd34d; }
    .tut-table-wrap { overflow-x: auto; margin: 14px 0 18px; border-radius: 10px; border: 1px solid var(--border); }
    .tut-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .tut-table th, .tut-table td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--border); color: var(--text); }
    .tut-table th { background: var(--border-light); font-weight: 700; font-size: 13px; color: var(--text-dim); white-space: nowrap; }
    .tut-table tr:last-child td { border-bottom: none; }
    .tut-table td:first-child { font-weight: 600; white-space: nowrap; }
    .tut-qa { margin: 14px 0; }
    .tut-qa .q { font-weight: 700; font-size: 14.5px; margin-bottom: 6px; display: flex; gap: 8px; color: var(--text); }
    .tut-qa .q::before { content: "Q"; color: var(--blue); font-weight: 800; flex-shrink: 0; }
    .tut-qa .a { padding-left: 22px; color: var(--text-dim); font-size: 14px; margin-bottom: 18px; }
    .tut-qa .a:last-child { margin-bottom: 0; }
    .tut-qa .a strong { color: var(--text); }
    .tut-links { display: grid; gap: 10px; margin: 16px 0 6px; }
    .tut-link { display: flex; align-items: center; gap: 12px; padding: 13px 16px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; transition: border-color 0.15s, background 0.15s; color: var(--text); text-decoration: none !important; }
    .tut-link:hover { border-color: var(--blue); background: var(--light-blue); }
    .tut-link .ico { font-size: 20px; flex-shrink: 0; width: 26px; text-align: center; }
    .tut-link .meta { flex: 1; min-width: 0; }
    .tut-link .meta .t { font-weight: 700; display: block; }
    .tut-link .meta .d { font-size: 12.5px; color: var(--text-dim); margin-top: 2px; word-break: break-all; }
    .tut-thanks { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0 8px; }
    .tut-thanks .person { flex: 1; min-width: 180px; padding: 14px 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--border-light); }
    .tut-thanks .person .name { font-weight: 800; font-size: 15px; margin-bottom: 4px; color: var(--text); }
    .tut-thanks .person .role { font-size: 13px; color: var(--text-dim); line-height: 1.5; }
    .tut-footer { text-align: center; padding-top: 24px; border-top: 1px solid var(--border); margin-top: 24px; font-size: 13px; color: var(--text-dim); display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 20px; }

    /* ============ 测试装备页 ============ */
    .wp-group { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; margin: 10px 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; box-shadow: var(--shadow); }
    .wp-group label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--text); }
    .wp-group input[type=text], .wp-group input[type=number] { width: auto; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; outline: none; background: var(--bg-input); color: var(--text); transition: border-color 0.15s; }
    .wp-group input[type=text]:focus, .wp-group input[type=number]:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    .wp-group input[type=number] { width: 150px; }
    .wp-group input[type=text] { width: 220px; }
    .wp-group input.wp-th-input { width: 62px; padding: 5px 8px; }
    .wp-group input[type=radio] { width: auto; margin: 0; }
    .wp-btn { padding: 7px 16px; border: 1px solid var(--blue); background: var(--bg-card); color: var(--blue); border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 600; transition: background .15s, color .15s; font-family: inherit; }
    .wp-btn:hover:not(:disabled) { background: var(--light-blue); }
    .wp-btn:disabled { opacity: .5; cursor: not-allowed; }
    .wp-btn.primary { background: var(--blue); color: #fff; }
    .wp-btn.primary:hover:not(:disabled) { background: var(--blue-hover); }
    .wp-btn.small { padding: 5px 10px; font-size: 13px; }
    .wp-btn.ghost { border-color: var(--border); color: var(--text-dim); }
    .wp-btn.ghost:hover:not(:disabled) { background: var(--border-light); color: var(--text); }
    .wp-btn.unit-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
    .wp-hint { color: var(--text-dim); font-size: 13px; line-height: 1.6; }
    .wp-hint code { background: var(--border-light); padding: 1px 5px; border-radius: 3px; font-size: 13px; color: var(--text); }
    .wp-textarea { width: 100%; height: 130px; padding: 10px; border: 1px solid var(--border); border-radius: 8px; font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 13px; line-height: 1.5; outline: none; resize: vertical; box-sizing: border-box; background: var(--bg-input); color: var(--text); transition: border-color 0.15s; }
    .wp-textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    .wp-progress { margin: 12px 0; font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 14px; color: var(--text-dim); min-height: 20px; }
    .wp-range { font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 13px; color: var(--text-dim); margin-left: 4px; }
    .wp-summary { margin: 14px 0 4px; font-size: 15px; color: var(--text); padding: 10px 14px; background: var(--light-blue); border: 1px solid var(--blue); border-radius: 8px; font-family: "SF Mono", Monaco, Consolas, monospace; }
    .wp-summary b { color: #dc2626; }
    body.dark .wp-summary b { color: #f87171; }
    .wp-summary .merged { color: #059669; font-weight: 600; }
    body.dark .wp-summary .merged { color: #34d399; }
    .wp-table { border-collapse: collapse; width: 100%; margin-top: 8px; font-size: 14px; }
    .wp-table th, .wp-table td { border: 1px solid var(--border); padding: 8px 10px; text-align: left; vertical-align: top; }
    .wp-table th { background: var(--border-light); font-weight: 600; white-space: nowrap; color: var(--text); }
    .wp-table td { color: var(--text); }
    .wp-table td.val { font-weight: 700; color: #dc2626; white-space: nowrap; }
    body.dark .wp-table td.val { color: #f87171; }
    .wp-table td.val.none { color: var(--text-dim); font-weight: 400; }
    .wp-table td.cnt { text-align: right; white-space: nowrap; font-family: "SF Mono", Monaco, Consolas, monospace; }
    .wp-table td.ex { font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 12px; word-break: break-all; color: var(--text); max-width: 720px; }
    .wp-sep { width: 1px; height: 24px; background: var(--border); }
    .wp-title { font-size: 16px; font-weight: 700; margin: 24px 0 8px 0; color: var(--text); }

    #w_toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.82); color: #fff; padding: 10px 22px; border-radius: 8px; font-size: 14px; z-index: 9999; opacity: 0; transition: opacity .3s; pointer-events: none; }
</style>
</head>
<body data-bg="fluid">

<div id="bg-base"></div>
<div class="bg-layer fluid" id="bg-fluid"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
<div class="bg-layer gold" id="bg-gold"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>

<nav class="navbar">
    <div class="nav-tabs">
        <button class="nav-tab active" data-page="filter">⚔️ 筛选</button>
        <button class="nav-tab" data-page="parse">📊 解析号</button>
        <button class="nav-tab" data-page="extract">🏷️ 提取名</button>
        <button class="nav-tab" data-page="weapon">⚒️ 测试装备</button>
        <button class="nav-tab" data-page="boss">👑 天卫战队测试</button>
        <button class="nav-tab" data-page="tutorial">📖 教程</button>
    </div>
    <div class="nav-actions">
        <button class="icon-btn" id="bg-toggle" title="切换背景">🎨 背景</button>
        <button class="icon-btn" id="theme-toggle" title="切换主题">🌓 主题</button>
    </div>
</nav>

<main class="container">

    <!-- ============ 筛选页 ============ -->
    <section id="page-filter" class="page active">
        <div class="card">
            <h4 class="card-title">基础配置</h4>
            <div class="row">
                <div class="item"><label>前缀</label><input type="text" id="prefix" value="Fin"></div>
