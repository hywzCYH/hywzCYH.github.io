async function bossLoadModels(){
    if(bossModelData) return;
    if(modelData){ bossOnMainModelsReady(modelData); return; }
    if(bossModelsLoading) return;
    bossModelsLoading = true;
    const prog = $b('b_prog');
    prog.innerText = "正在从云端加载模型 (8s超时)...";
    const files = ["qp0", "qd0", "pp0", "cqd0", "cqd3"];
    let ok = 0;
    try {
        const promises = files.map(async (name) => {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 8000);
            try {
                let res = await fetch("https://hywzcyh.github.io/NrD/" + name, { signal: controller.signal });
                if(!res.ok) throw new Error("HTTP " + res.status);
                let text = await res.text();
                let arr;
                if (text.startsWith('[')) { try { arr = JSON.parse(text); } catch(e) { arr = new Function('return ' + text)(); } }
                else { let m = text.match(/\[[\s\S]*\]/); if(m) arr = new Function('return ' + m[0])(); }
                if (!arr || !arr.length) throw new Error("数据解析失败");
                let f64 = new Float64Array(arr); ok++;
                prog.innerText = "加载模型... (" + ok + "/" + files.length + ")";
                return { name, f64 };
            } finally { clearTimeout(timeoutId); }
        });
        const results = await Promise.all(promises);
        if(bossModelData) return;
        bossModelData = {};
        results.forEach(r => { bossModelData[r.name] = r.f64; });
        prog.innerText = "✅ 模型加载完成";
        $b('b_runBtn').disabled = false;
    } catch(e){
        prog.innerText = "❌ 云端加载失败：" + e.message;
    } finally {
        bossModelsLoading = false;
    }
}

function bossReadParams(){
    const unit = parseInt($b('b_unit').value);
    const parseTh = (id) => {
        const v = $b(id).value.trim();
        if(v === '') return null;
        const n = parseFloat(v);
        return isNaN(n) ? null : n;
    };
    return {
        prefix: $b('b_prefix').value.trim(),
        start: Math.round(parseFloat($b('b_start').value) * unit),
        end: Math.round(parseFloat($b('b_end').value) * unit),
        th_e8: parseFloat($b('b_th_e8').value) || 0,
        BLOCK: Math.max(500, parseInt($b('b_block').value) || 100000),
        threads: parseInt($b('b_threads').value),
        th_sqp: parseTh('b_th_sqp'), th_sqd: parseTh('b_th_sqd'),
        th_spp: parseTh('b_th_spp'), th_scqd: parseTh('b_th_scqd'),
    };
}

function bossParamsEqual(a, b){
    return a.prefix === b.prefix && a.start === b.start && a.end === b.end
        && a.th_e8 === b.th_e8 && a.BLOCK === b.BLOCK && a.threads === b.threads
        && a.th_sqp === b.th_sqp && a.th_sqd === b.th_sqd && a.th_spp === b.th_spp && a.th_scqd === b.th_scqd;
